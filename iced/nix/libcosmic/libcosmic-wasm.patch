 pub use menu_inner::{CloseCondition, ItemHeight, ItemWidth, PathHighlight};
 pub(crate) use menu_inner::{Direction, Menu, init_root_menu};
+/// Frosted glass behind a menu panel, where the renderer can do it.
+///
+/// **The compositor's frosting and this are different mechanisms.** On Wayland
+/// a menu that is a real popup surface gets `ext-background-effect-v1` and the
+/// compositor blurs what is behind the surface. Everywhere else — X11, macOS,
+/// Windows, and a browser, where the whole program is one canvas — a menu is
+/// an ordinary overlay inside the app's own surface, and nothing outside the
+/// app is going to blur anything. What is behind it there is something this
+/// renderer drew a moment ago, so `iced_wgpu` reads it back. See `blur.rs`.
+///
+/// Answers `false` when there is no such renderer, and the caller must then
+/// paint its background the ordinary opaque way.
+pub(crate) fn frost(
+    _renderer: &mut crate::Renderer,
+    _bounds: iced::Rectangle,
+    _radius: [f32; 4],
+    _tint: iced::Color,
+) -> bool {
+    #[cfg(feature = "wgpu")]
+    {
+        // Wide enough that no letter behind the panel survives, which is the
+        // test that matters: a menu you can read the page through is worse
+        // than an opaque one.
+        const SIGMA: f32 = 18.0;
+        // …and carried most of the way to the menu's own ground, so it reads
+        // as a panel on a plane of its own rather than as a smear.
+        const TINT: f32 = 0.12;
+
+        iced_wgpu::blur::Renderer::draw_blur(
+            _renderer,
+            _bounds,
+            _radius,
+            SIGMA,
+            iced::Color {
+                a: TINT,
+                .._tint
+            },
+        )
+    }
+    #[cfg(not(feature = "wgpu"))]
+    false
+}
