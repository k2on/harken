+    let spacing = crate::theme::spacing();
+    let l: Cow<'static, str> = label.into();
+    let mut items: Vec<crate::Element<'static, Message>> = Vec::with_capacity(5);
+
+    // The same column `entry_tree` draws, for the same reason: what a row *is*
+    // must not be decided by whether it happens to have a drawing.
+    match icon {
+        IconSlot::Icon(icon) => {
+            items.push(widget::icon::icon(icon).size(14).into());
+            items.push(widget::space::horizontal().width(spacing.space_xxs).into());
+        }
+        IconSlot::Reserved => {
+            items.push(
+                widget::space::horizontal()
