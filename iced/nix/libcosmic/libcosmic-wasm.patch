+/// Where a key's bytes actually live.
+///
+/// Every path in this crate is a *name* - the config dir, the app, the
+/// version, the key - and on a desktop that name is a file. A browser has no
+/// filesystem, so there the same name is a key in `localStorage`: the naming
+/// stays in one place and only the two ends of it move.
+#[cfg(not(target_arch = "wasm32"))]
+mod store {
+    use std::io::Write;
+    use std::path::Path;
+
+    pub fn create_dir_all(path: &Path) -> std::io::Result<()> {
+        std::fs::create_dir_all(path)
+    }
+
+    pub fn read_to_string(path: &Path) -> std::io::Result<String> {
+        std::fs::read_to_string(path)
+    }
+
+    pub fn write(path: &Path, data: &str) -> Result<(), super::Error> {
+        atomicwrites::AtomicFile::new(path, atomicwrites::OverwriteBehavior::AllowOverwrite)
+            .write(|file| file.write_all(data.as_bytes()))?;
+        Ok(())
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+mod store {
+    use std::path::Path;
+
+    /// Absent in a worker, and in a window whose site data is blocked - both
+    /// of which read here as "this key is not set", which is the truth.
+    fn local() -> Option<web_sys::Storage> {
+        web_sys::window()?.local_storage().ok().flatten()
+    }
+
+    /// There are no directories to make.
+    pub fn create_dir_all(_path: &Path) -> std::io::Result<()> {
+        Ok(())
+    }
+
+    pub fn read_to_string(path: &Path) -> std::io::Result<String> {
+        local()
+            .and_then(|s| s.get_item(&path.to_string_lossy()).ok().flatten())
+            .ok_or_else(|| {
+                std::io::Error::new(std::io::ErrorKind::NotFound, "no such key in localStorage")
+            })
+    }
+
+    pub fn write(path: &Path, data: &str) -> Result<(), super::Error> {
+        let storage = local().ok_or_else(|| {
+            std::io::Error::other("localStorage is unavailable in this context")
+        })?;
+        storage
+            .set_item(&path.to_string_lossy(), data)
+            // A quota failure is the usual one, and its reason is a JsValue.
+            .map_err(|_| std::io::Error::other("localStorage refused the write"))?;
+        Ok(())
+    }
+}
