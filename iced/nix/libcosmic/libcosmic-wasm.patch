+    use std::path::Path;
+
+    /// Absent in a worker, and in a window whose site data is blocked - both
+    /// of which read here as "this key is not set", which is the truth.
+    fn local() -> Option<web_sys::Storage> {
+        web_sys::window()?.local_storage().ok().flatten()
+    }
+
+    /// There are no directories to make.
+    pub fn create_dir_all(_path: &Path) -> std::io::Result<()> {
+        Ok(())
+    }
+
+    pub fn read_to_string(path: &Path) -> std::io::Result<String> {
+        local()
+            .and_then(|s| s.get_item(&path.to_string_lossy()).ok().flatten())
+            .ok_or_else(|| {
+                std::io::Error::new(std::io::ErrorKind::NotFound, "no such key in localStorage")
+            })
+    }
+
+    pub fn write(path: &Path, data: &str) -> Result<(), super::Error> {
+        let storage = local()
+            .ok_or_else(|| std::io::Error::other("localStorage is unavailable in this context"))?;
