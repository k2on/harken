diff --git a/cosmic-config/src/subscription_web.rs b/cosmic-config/src/subscription_web.rs
new file mode 100644
index 0000000..1aa6dae
--- /dev/null
+++ b/cosmic-config/src/subscription_web.rs
@@ -0,0 +1,41 @@
+//! The config subscription, for a browser.
+//!
+//! The desktop one is a `notify` watcher over the config directory. There is
+//! no directory here and no watcher, so this is the same two functions
+//! answering that nothing has changed.
+//!
+//! It is not the end of the story: `localStorage` does fire a `storage` event,
+//! but only for writes made by *other* tabs, so a real implementation has to
+//! announce its own writes as well. Until it does, a page reads its config at
+//! startup and does not hear about later edits — which is a limitation to know
+//! about rather than a silent one, because a subscription that never fires and
+//! a watcher that is broken look identical from the outside.
+
+use std::borrow::Cow;
+use std::hash::Hash;
+
+use crate::CosmicConfigEntry;
+
+#[cold]
+pub fn config_subscription<
+    I: 'static + Hash,
+    T: 'static + Send + Sync + PartialEq + Clone + CosmicConfigEntry,
+>(
+    _id: I,
+    _config_id: Cow<'static, str>,
+    _config_version: u64,
+) -> iced_futures::Subscription<crate::Update<T>> {
+    iced_futures::Subscription::none()
+}
+
+#[cold]
+pub fn config_state_subscription<
+    I: 'static + Hash,
+    T: 'static + Send + Sync + PartialEq + Clone + CosmicConfigEntry,
+>(
+    _id: I,
+    _config_id: Cow<'static, str>,
+    _config_version: u64,
+) -> iced_futures::Subscription<crate::Update<T>> {
+    iced_futures::Subscription::none()
+}
