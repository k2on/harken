index 0000000..2f4cc7f
--- /dev/null
+++ b/wgpu/src/blur.rs
@@ -0,0 +1,585 @@
+//! A blur of whatever has already been drawn.
+//!
+//! This is frosted glass, done in the renderer rather than by a compositor. The
+//! difference matters: COSMIC's own frosting is `ext-background-effect-v1`, a
+//! Wayland protocol, so it is unavailable on X11, on macOS, on Windows, and in
+//! a browser, where the whole program is one canvas with nothing behind it.
+//! What is behind a *panel*, though, is something this renderer drew a moment
+//! ago and can therefore read back.
+//!
+//! **The surface cannot be read, which is the constraint the design falls out
+//! of.** `window::Compositor` configures it `RENDER_ATTACHMENT` and nothing
+//! else, so it can be neither sampled nor copied — and widening that is not
+//! portable, because a WebGL canvas is not a texture wgpu may read. So a frame
+//! that contains a blur is drawn into a texture of our own instead, and blitted
+//! to the surface at the end. A frame that contains no blur is drawn straight
+//! at the surface exactly as before, so the cost is paid only while a frosted
+//! panel is actually on screen.
+//!
+//! Three passes per layer that asks for one, at quarter resolution:
+//! horizontal, vertical, then a rounded-rect composite back into the scene.
+//! Quarter resolution is not only a saving — it is most of the blur, since one
+//! texel there reaches four pixels, and the nine taps then span sixteen.
+//!
+//! **Sampling the target you are writing to is the thing to not do**, and the
+//! reason the pass is ended and begun again around all of this. The blur passes
+//! read the scene while nothing is writing it; the composite writes the scene
+//! while reading only the scratch texture it just filled.
+
+use crate::core::{Color, Rectangle};
+
+/// A rounded panel that shows a blurred copy of what is behind it.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Blur {
+    /// Where the panel is, in logical coordinates.
+    pub bounds: Rectangle,
+    /// Its corners, in the order iced packs them.
+    pub radius: [f32; 4],
+    /// How far the blur reaches, in logical pixels.
+    pub sigma: f32,
+    /// Mixed over the blurred pixels by its own alpha, because a frosted panel
+    /// is not only blurred — it is also carried towards the theme's own ground,
+    /// or nothing on it would be legible.
+    pub tint: Color,
+}
+
+/// The blurs of a single layer.
+pub type Batch = Vec<Blur>;
+
+/// A renderer that can blur what it has already drawn.
+///
+/// Separate from [`crate::primitive::Renderer`] because a custom primitive is
+/// handed a `TextureView` and this needs the `Texture` behind it, and because a
+/// primitive cannot end the render pass it is being drawn inside.
+pub trait Renderer: crate::core::Renderer {
+    /// Blurs whatever is behind `bounds`, and stamps it back with rounded
+    /// corners and a tint.
+    ///
+    /// Drawn *under* everything else in the same layer, so the panel this is
+    /// for should carry its border and its contents as usual and leave its
+    /// background to this.
+    ///
+    /// **Answers whether it will actually happen**, because a caller that has
+    /// dropped its own background on the strength of this needs to know when
+    /// nothing took its place. A software renderer says `false`, and the
+    /// panel must then paint itself the ordinary opaque way — a panel with no
+    /// ground at all is see-through, which is worse than never having asked.
+    fn draw_blur(
+        &mut self,
+        bounds: Rectangle,
+        radius: [f32; 4],
+        sigma: f32,
+        tint: Color,
+    ) -> bool;
+}
+
+/// How much smaller the scratch textures are than the scene.
+const DOWNSCALE: u32 = 4;
+
+#[repr(C)]
+#[derive(Debug, Clone, Copy, bytemuck::Zeroable, bytemuck::Pod)]
+struct Uniforms {
+    rect: [f32; 4],
+    radius: [f32; 4],
+    tint: [f32; 4],
+    screen: [f32; 2],
+    step: [f32; 2],
+}
+
+/// The alignment a dynamic uniform offset must have. 256 is the maximum any
+/// backend asks for, so using it unconditionally costs a little padding and
+/// never has to ask the device.
+const STRIDE: u64 = 256;
+
+#[derive(Debug, Clone)]
+pub struct Pipeline {
+    blur: wgpu::RenderPipeline,
+    panel: wgpu::RenderPipeline,
+    copy: wgpu::RenderPipeline,
+    sampler: wgpu::Sampler,
+    source_layout: wgpu::BindGroupLayout,
+    uniforms_layout: wgpu::BindGroupLayout,
+}
+
+impl Pipeline {
+    pub fn new(device: &wgpu::Device, format: wgpu::TextureFormat) -> Self {
+        let source_layout =
+            device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+                label: Some("iced_wgpu.blur.source_layout"),
+                entries: &[
+                    wgpu::BindGroupLayoutEntry {
+                        binding: 0,
+                        visibility: wgpu::ShaderStages::FRAGMENT,
+                        ty: wgpu::BindingType::Texture {
+                            sample_type: wgpu::TextureSampleType::Float {
+                                filterable: true,
+                            },
+                            view_dimension: wgpu::TextureViewDimension::D2,
+                            multisampled: false,
+                        },
+                        count: None,
+                    },
+                    wgpu::BindGroupLayoutEntry {
+                        binding: 1,
+                        visibility: wgpu::ShaderStages::FRAGMENT,
+                        ty: wgpu::BindingType::Sampler(
+                            wgpu::SamplerBindingType::Filtering,
+                        ),
+                        count: None,
+                    },
+                ],
+            });
+
+        let uniforms_layout =
+            device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+                label: Some("iced_wgpu.blur.uniforms_layout"),
+                entries: &[wgpu::BindGroupLayoutEntry {
+                    binding: 0,
+                    visibility: wgpu::ShaderStages::VERTEX
+                        | wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Buffer {
+                        ty: wgpu::BufferBindingType::Uniform,
+                        has_dynamic_offset: true,
+                        min_binding_size: wgpu::BufferSize::new(
+                            std::mem::size_of::<Uniforms>() as u64,
+                        ),
+                    },
+                    count: None,
+                }],
+            });
+
+        let layout =
+            device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+                label: Some("iced_wgpu.blur.pipeline_layout"),
+                bind_group_layouts: &[&source_layout, &uniforms_layout],
+                immediate_size: 0,
+            });
+
+        let shader =
+            device.create_shader_module(wgpu::ShaderModuleDescriptor {
+                label: Some("iced_wgpu.blur.shader"),
+                source: wgpu::ShaderSource::Wgsl(std::borrow::Cow::Borrowed(
+                    include_str!("shader/blur.wgsl"),
+                )),
+            });
+
+        let targets = [Some(wgpu::ColorTargetState {
+            format,
+            blend: Some(wgpu::BlendState::PREMULTIPLIED_ALPHA_BLENDING),
+            write_mask: wgpu::ColorWrites::ALL,
+        })];
+
+        // The two full-screen passes write every pixel of their target, so they
+        // replace rather than blend — blending a blur into a stale scratch
+        // texture is last frame's panel showing through this frame's.
+        let opaque = [Some(wgpu::ColorTargetState {
+            format,
+            blend: Some(wgpu::BlendState::REPLACE),
+            write_mask: wgpu::ColorWrites::ALL,
+        })];
+
+        let full = |label, entry_point, targets: &[Option<
+            wgpu::ColorTargetState,
+        >], topology| {
+            device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+                label: Some(label),
+                layout: Some(&layout),
+                vertex: wgpu::VertexState {
+                    module: &shader,
+                    entry_point: Some(match topology {
+                        wgpu::PrimitiveTopology::TriangleStrip => "vs_panel",
+                        _ => "vs_full",
+                    }),
+                    buffers: &[],
+                    compilation_options:
+                        wgpu::PipelineCompilationOptions::default(),
+                },
+                fragment: Some(wgpu::FragmentState {
+                    module: &shader,
+                    entry_point: Some(entry_point),
+                    targets,
+                    compilation_options:
+                        wgpu::PipelineCompilationOptions::default(),
+                }),
+                primitive: wgpu::PrimitiveState {
+                    topology,
+                    ..Default::default()
+                },
+                depth_stencil: None,
+                multisample: wgpu::MultisampleState::default(),
+                multiview_mask: None,
+                cache: None,
+            })
+        };
+
+        Self {
+            blur: full(
+                "iced_wgpu.blur.gaussian",
+                "fs_blur",
+                &opaque,
+                wgpu::PrimitiveTopology::TriangleList,
+            ),
+            panel: full(
+                "iced_wgpu.blur.panel",
+                "fs_panel",
+                &targets,
+                wgpu::PrimitiveTopology::TriangleStrip,
+            ),
+            copy: full(
+                "iced_wgpu.blur.copy",
+                "fs_copy",
+                &opaque,
+                wgpu::PrimitiveTopology::TriangleList,
+            ),
+            sampler: device.create_sampler(&wgpu::SamplerDescriptor {
+                label: Some("iced_wgpu.blur.sampler"),
+                address_mode_u: wgpu::AddressMode::ClampToEdge,
+                address_mode_v: wgpu::AddressMode::ClampToEdge,
+                address_mode_w: wgpu::AddressMode::ClampToEdge,
+                mag_filter: wgpu::FilterMode::Linear,
+                min_filter: wgpu::FilterMode::Linear,
+                ..Default::default()
+            }),
+            source_layout,
+            uniforms_layout,
+        }
+    }
+}
+
+/// The textures and the uniform buffer, which belong to a renderer rather than
+/// to the device because they are sized by the window.
+#[derive(Debug, Default)]
+pub struct State {
+    targets: Option<Targets>,
+    uniforms: Option<(wgpu::Buffer, wgpu::BindGroup, u64)>,
+    /// The next free slot of the uniform buffer, for this frame.
+    ///
+    /// **Every layer that blurs needs slots of its own, and this is why.**
+    /// `queue.write_buffer` is ordered before the whole command buffer, so two
+    /// layers writing the same offsets would both run against whichever wrote
+    /// last — the second panel's sigma, silently, on the first. A `Cell`
+    /// because the render loop holds this by shared reference: `frame` is
+    /// borrowed out of `targets` for the length of the loop.
+    slot: std::cell::Cell<u64>,
+}
+
+#[derive(Debug)]
+struct Targets {
+    size: (u32, u32),
+    /// Everything drawn this frame, which is what a blur reads.
+    scene: wgpu::TextureView,
+    scene_source: wgpu::BindGroup,
+    /// Quarter size, and used in turn: horizontal into `a`, vertical into `b`.
+    a: wgpu::TextureView,
+    a_source: wgpu::BindGroup,
+    b: wgpu::TextureView,
+    b_source: wgpu::BindGroup,
+}
+
+impl State {
+    /// The view every layer of a blurred frame is drawn into.
+    ///
+    /// `None` when the frame has no blur in it, which is the ordinary case and
+    /// means "draw straight at the surface".
+    pub fn scene(&self) -> Option<&wgpu::TextureView> {
+        self.targets.as_ref().map(|targets| &targets.scene)
+    }
+
+    /// Makes the offscreen textures, or keeps them if the window has not moved.
+    pub fn prepare(
+        &mut self,
+        pipeline: &Pipeline,
+        device: &wgpu::Device,
+        format: wgpu::TextureFormat,
+        size: (u32, u32),
+        slots: u64,
+    ) {
+        let size = (size.0.max(1), size.1.max(1));
+
+        if self.targets.as_ref().is_none_or(|t| t.size != size) {
+            let texture = |label, (width, height): (u32, u32)| {
+                device
+                    .create_texture(&wgpu::TextureDescriptor {
+                        label: Some(label),
+                        size: wgpu::Extent3d {
+                            width,
+                            height,
+                            depth_or_array_layers: 1,
+                        },
+                        mip_level_count: 1,
+                        sample_count: 1,
+                        dimension: wgpu::TextureDimension::D2,
+                        format,
+                        usage: wgpu::TextureUsages::RENDER_ATTACHMENT
+                            | wgpu::TextureUsages::TEXTURE_BINDING,
+                        view_formats: &[],
+                    })
+                    .create_view(&wgpu::TextureViewDescriptor::default())
+            };
+
+            let source = |label, view: &wgpu::TextureView| {
+                device.create_bind_group(&wgpu::BindGroupDescriptor {
+                    label: Some(label),
+                    layout: &pipeline.source_layout,
+                    entries: &[
+                        wgpu::BindGroupEntry {
+                            binding: 0,
+                            resource: wgpu::BindingResource::TextureView(view),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 1,
+                            resource: wgpu::BindingResource::Sampler(
+                                &pipeline.sampler,
+                            ),
+                        },
+                    ],
+                })
+            };
+
+            let small = (
+                (size.0 / DOWNSCALE).max(1),
+                (size.1 / DOWNSCALE).max(1),
+            );
+
+            let scene = texture("iced_wgpu.blur.scene", size);
+            let a = texture("iced_wgpu.blur.a", small);
+            let b = texture("iced_wgpu.blur.b", small);
+
+            self.targets = Some(Targets {
+                size,
+                scene_source: source("iced_wgpu.blur.scene_source", &scene),
+                a_source: source("iced_wgpu.blur.a_source", &a),
+                b_source: source("iced_wgpu.blur.b_source", &b),
+                scene,
+                a,
+                b,
+            });
+        }
+
+        self.slot.set(0);
+
+        // Every pass recorded this frame needs a slice of its own, because they
+        // are all written before any of them runs.
+        let needed = slots.max(1) * STRIDE;
+
+        if self.uniforms.as_ref().is_none_or(|(_, _, size)| *size < needed) {
+            let buffer = device.create_buffer(&wgpu::BufferDescriptor {
+                label: Some("iced_wgpu.blur.uniforms"),
+                size: needed,
+                usage: wgpu::BufferUsages::UNIFORM
+                    | wgpu::BufferUsages::COPY_DST,
+                mapped_at_creation: false,
+            });
+
+            let group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("iced_wgpu.blur.uniforms_group"),
+                layout: &pipeline.uniforms_layout,
+                entries: &[wgpu::BindGroupEntry {
+                    binding: 0,
+                    resource: wgpu::BindingResource::Buffer(
+                        wgpu::BufferBinding {
+                            buffer: &buffer,
+                            offset: 0,
+                            size: wgpu::BufferSize::new(
+                                std::mem::size_of::<Uniforms>() as u64,
+                            ),
+                        },
+                    ),
+                }],
+            });
+
+            self.uniforms = Some((buffer, group, needed));
+        }
+    }
+
+    /// Runs the two blur passes once, then composites every panel of this layer
+    /// from the one blurred copy — they all read the same scene, so blurring it
+    /// per panel would be the same work repeated.
+    #[allow(clippy::too_many_arguments)]
+    pub fn render(
+        &self,
+        pipeline: &Pipeline,
+        queue: &wgpu::Queue,
+        encoder: &mut wgpu::CommandEncoder,
+        blurs: &Batch,
+        scale: f32,
+        size: (u32, u32),
+    ) {
+        let (Some(targets), Some((buffer, group, _))) =
+            (self.targets.as_ref(), self.uniforms.as_ref())
+        else {
+            return;
+        };
+
+        // Two blur passes and a composite per panel.
+        let base = self.slot.get();
+        self.slot.set(base + 2 + blurs.len() as u64);
+
+        let screen = [size.0 as f32, size.1 as f32];
+        let small = [
+            (size.0 / DOWNSCALE).max(1) as f32,
+            (size.1 / DOWNSCALE).max(1) as f32,
+        ];
+
+        // The widest sigma on this layer decides the one blur they share. A
+        // panel asking for less gets a little more, which is invisible; the
+        // alternative is a blurred copy per distinct sigma, for a difference
+        // nobody can see.
+        let sigma = blurs
+            .iter()
+            .map(|blur| blur.sigma * scale)
+            .fold(0.0_f32, f32::max)
+            .max(1.0);
+
+        // Nine taps reach four steps either side, and the texels are already
+        // `DOWNSCALE` pixels wide.
+        let reach = sigma / DOWNSCALE as f32 / 4.0;
+
+        let blank = Uniforms {
+            rect: [0.0; 4],
+            radius: [0.0; 4],
+            tint: [0.0; 4],
+            screen,
+            step: [0.0; 2],
+        };
+
+        queue.write_buffer(
+            buffer,
+            base * STRIDE,
+            bytemuck::bytes_of(&Uniforms {
+                step: [reach / small[0], 0.0],
+                ..blank
+            }),
+        );
+        queue.write_buffer(
+            buffer,
+            (base + 1) * STRIDE,
+            bytemuck::bytes_of(&Uniforms {
+                step: [0.0, reach / small[1]],
+                ..blank
+            }),
+        );
+
+        for (index, blur) in blurs.iter().enumerate() {
+            let bounds = blur.bounds * scale;
+
+            queue.write_buffer(
+                buffer,
+                (base + index as u64 + 2) * STRIDE,
+                bytemuck::bytes_of(&Uniforms {
+                    rect: [
+                        bounds.x,
+                        bounds.y,
+                        bounds.width,
+                        bounds.height,
+                    ],
+                    radius: blur.radius.map(|r| r * scale),
+                    tint: [
+                        blur.tint.r,
+                        blur.tint.g,
+                        blur.tint.b,
+                        blur.tint.a,
+                    ],
+                    screen,
+                    step: [0.0; 2],
+                }),
+            );
+        }
+
+        let mut run = |label,
+                        target: &wgpu::TextureView,
+                        source: &wgpu::BindGroup,
+                        which: &wgpu::RenderPipeline,
+                        offset: u64,
+                        vertices: u32| {
+            let mut pass =
+                encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                    label: Some(label),
+                    color_attachments: &[Some(
+                        wgpu::RenderPassColorAttachment {
+                            view: target,
+                            depth_slice: None,
+                            resolve_target: None,
+                            ops: wgpu::Operations {
+                                load: wgpu::LoadOp::Load,
+                                store: wgpu::StoreOp::Store,
+                            },
+                        },
+                    )],
+                    depth_stencil_attachment: None,
+                    timestamp_writes: None,
+                    occlusion_query_set: None,
+                    multiview_mask: None,
+                });
+
+            pass.set_pipeline(which);
+            pass.set_bind_group(0, source, &[]);
+            pass.set_bind_group(1, group, &[offset as u32]);
+            pass.draw(0..vertices, 0..1);
+        };
+
+        run(
+            "iced_wgpu.blur.horizontal",
+            &targets.a,
+            &targets.scene_source,
+            &pipeline.blur,
+            base * STRIDE,
+            3,
+        );
+        run(
+            "iced_wgpu.blur.vertical",
+            &targets.b,
+            &targets.a_source,
+            &pipeline.blur,
+            (base + 1) * STRIDE,
+            3,
+        );
+
+        for index in 0..blurs.len() {
+            run(
+                "iced_wgpu.blur.panel",
+                &targets.scene,
+                &targets.b_source,
+                &pipeline.panel,
+                (base + index as u64 + 2) * STRIDE,
+                4,
+            );
+        }
+    }
+
+    /// Puts the finished scene on the surface.
+    pub fn present(
+        &self,
+        pipeline: &Pipeline,
+        encoder: &mut wgpu::CommandEncoder,
+        frame: &wgpu::TextureView,
+    ) {
+        let (Some(targets), Some((_, group, _))) =
+            (self.targets.as_ref(), self.uniforms.as_ref())
+        else {
+            return;
+        };
+
+        let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+            label: Some("iced_wgpu.blur.present"),
+            color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                view: frame,
+                depth_slice: None,
+                resolve_target: None,
+                ops: wgpu::Operations {
+                    load: wgpu::LoadOp::Load,
+                    store: wgpu::StoreOp::Store,
+                },
+            })],
+            depth_stencil_attachment: None,
+            timestamp_writes: None,
+            occlusion_query_set: None,
+            multiview_mask: None,
+        });
+
+        pass.set_pipeline(&pipeline.copy);
+        pass.set_bind_group(0, &targets.scene_source, &[]);
+        pass.set_bind_group(1, group, &[0]);
+        pass.draw(0..3, 0..1);
+    }
+}
