new file mode 100644
index 0000000..bf76755
--- /dev/null
+++ b/wgpu/src/shader/blur.wgsl
@@ -0,0 +1,123 @@
+// A blur of whatever has already been drawn, and the rounded panel that shows it.
+//
+// Three entry points over one bind group layout, because they are three steps of
+// one effect: two separable Gaussian passes at quarter resolution, and a
+// composite that stamps the result back into the scene through a rounded-rect
+// mask. `fs_copy` is the fourth, and only exists to get the finished scene onto
+// the surface — see `blur.rs` for why the scene cannot be the surface itself.
+
+struct Uniforms {
+    // The panel, in physical pixels: x, y, width, height.
+    rect: vec4<f32>,
+    // Its corners, in the order iced packs them: top left, top right,
+    // bottom right, bottom left.
+    radius: vec4<f32>,
+    // Mixed over the blurred pixels by its own alpha. A frosted panel is not
+    // only blurred, it is also lightened or darkened towards the theme.
+    tint: vec4<f32>,
+    // The viewport, in physical pixels.
+    screen: vec2<f32>,
+    // One tap of the current blur pass, in UV. Horizontal is (1/w, 0) times
+    // however far the sigma reaches; vertical is (0, 1/h).
+    step: vec2<f32>,
+}
+
+@group(0) @binding(0) var source: texture_2d<f32>;
+@group(0) @binding(1) var source_sampler: sampler;
+@group(1) @binding(0) var<uniform> uniforms: Uniforms;
+
+struct Full {
+    @builtin(position) position: vec4<f32>,
+    @location(0) uv: vec2<f32>,
+}
+
+// One oversized triangle rather than two, so there is no seam down the diagonal
+// and no vertex buffer to bind.
+@vertex
+fn vs_full(@builtin(vertex_index) index: u32) -> Full {
+    let x = f32(i32(index) / 2) * 4.0 - 1.0;
+    let y = f32(i32(index) & 1) * 4.0 - 1.0;
+
+    var out: Full;
+    out.position = vec4<f32>(x, y, 0.0, 1.0);
+    out.uv = vec2<f32>((x + 1.0) * 0.5, 1.0 - (y + 1.0) * 0.5);
+    return out;
+}
+
+// Nine taps, unrolled. The weights are a normalised Gaussian, and they are
+// written out rather than indexed because a runtime index into a constant array
+// is the one thing naga will not lower to GLSL ES for the WebGL backend.
+@fragment
+fn fs_blur(in: Full) -> @location(0) vec4<f32> {
+    let d1 = uniforms.step;
+    let d2 = uniforms.step * 2.0;
+    let d3 = uniforms.step * 3.0;
+    let d4 = uniforms.step * 4.0;
+
+    var sum = textureSample(source, source_sampler, in.uv) * 0.2270270270;
+    sum += textureSample(source, source_sampler, in.uv + d1) * 0.1945945946;
+    sum += textureSample(source, source_sampler, in.uv - d1) * 0.1945945946;
+    sum += textureSample(source, source_sampler, in.uv + d2) * 0.1216216216;
+    sum += textureSample(source, source_sampler, in.uv - d2) * 0.1216216216;
+    sum += textureSample(source, source_sampler, in.uv + d3) * 0.0540540541;
+    sum += textureSample(source, source_sampler, in.uv - d3) * 0.0540540541;
+    sum += textureSample(source, source_sampler, in.uv + d4) * 0.0162162162;
+    sum += textureSample(source, source_sampler, in.uv - d4) * 0.0162162162;
+    return sum;
+}
+
+// Straight through, for getting the offscreen scene onto the surface.
+@fragment
+fn fs_copy(in: Full) -> @location(0) vec4<f32> {
+    return textureSample(source, source_sampler, in.uv);
+}
+
+struct Panel {
+    @builtin(position) position: vec4<f32>,
+    // Where this fragment is on the screen, so the blurred copy is sampled at
+    // the place it was blurred from rather than at an offset into the panel.
+    @location(0) uv: vec2<f32>,
+    // …and where it is inside the panel, for the corner.
+    @location(1) local: vec2<f32>,
+}
+
+// A triangle strip of four: (0,0) (1,0) (0,1) (1,1).
+@vertex
+fn vs_panel(@builtin(vertex_index) index: u32) -> Panel {
+    let corner = vec2<f32>(f32(index & 1u), f32((index >> 1u) & 1u));
+    let px = uniforms.rect.xy + corner * uniforms.rect.zw;
+
+    var out: Panel;
+    out.position = vec4<f32>(
+        px.x / uniforms.screen.x * 2.0 - 1.0,
+        1.0 - px.y / uniforms.screen.y * 2.0,
+        0.0,
+        1.0,
+    );
+    out.uv = px / uniforms.screen;
+    out.local = px - (uniforms.rect.xy + uniforms.rect.zw * 0.5);
+    return out;
+}
+
+// iced's own, from `quad.wgsl`, so a frosted panel and an ordinary one round
+// their corners by the same arithmetic.
+fn rounded_box_sdf(p: vec2<f32>, size: vec2<f32>, corners: vec4<f32>) -> f32 {
+    var box_half = select(corners.yz, corners.xw, p.x > 0.0);
+    var corner = select(box_half.y, box_half.x, p.y > 0.0);
+    var q = abs(p) - size + corner;
+    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0))) - corner;
+}
+
+@fragment
+fn fs_panel(in: Panel) -> @location(0) vec4<f32> {
+    let half_size = uniforms.rect.zw * 0.5;
+    let distance = rounded_box_sdf(in.local, half_size, uniforms.radius);
+    // Half a pixel either side of the edge, which is what antialiases it.
+    let alpha = 1.0 - smoothstep(-0.5, 0.5, distance);
+
+    let blurred = textureSample(source, source_sampler, in.uv).rgb;
+    let tinted = mix(blurred, uniforms.tint.rgb, uniforms.tint.a);
+
+    // Premultiplied, because that is the blend this pipeline is built with.
+    return vec4<f32>(tinted * alpha, alpha);
+}
